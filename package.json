{
  "name": "codewhale-launcher",
  "displayName": "CodeWhale Launcher",
  "description": "Launch the locally installed CodeWhale CLI from a dedicated VS Code integrated terminal.",
  "version": "0.0.1",
  "publisher": "codewhale",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codewhaleLauncher.open",
    "onCommand:codewhaleLauncher.restart",
    "onCommand:codewhaleLauncher.stop"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/blealf/codewhale-terminal"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "codewhaleLauncher.open",
        "title": "CodeWhale: Open",
        "category": "CodeWhale",
        "icon": {
          "light": "media/codewhale.svg",
          "dark": "media/codewhale.svg"
        }
      },
      {
        "command": "codewhaleLauncher.restart",
        "title": "CodeWhale: Restart",
        "category": "CodeWhale"
      },
      {
        "command": "codewhaleLauncher.stop",
        "title": "CodeWhale: Stop",
        "category": "CodeWhale"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codewhaleLauncher.open",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "CodeWhale Launcher",
      "properties": {
        "codewhale.command": {
          "type": "string",
          "default": "codewhale",
          "description": "Executable used to launch CodeWhale from the integrated terminal."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.79.0",
    "typescript": "^5.6.0"
  }
}
